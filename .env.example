# =========================================================
# ForecastGPT configuration
# Copy this file to ".env" and fill in your own values.
# Every default below runs 100% locally / free of charge.
# =========================================================

# ---- LLM provider ----
# The provider is abstracted (see backend/app/agents/llm.py) so you can
# swap it out later without touching any agent/graph code.
LLM_PROVIDER=groq

# Get a free key at https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here

# Any current free-tier Groq model works. llama-3.1-8b-instant is fast & cheap.
GROQ_MODEL=llama-3.1-8b-instant

# ---- Embeddings (local, free, no API calls) ----
EMBEDDING_MODEL=all-MiniLM-L6-v2

# ---- Qdrant (local vector DB via Docker) ----
QDRANT_HOST=localhost
QDRANT_PORT=6333
QDRANT_COLLECTION=forecastgpt_knowledge

# ---- Backend ----
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
LOG_LEVEL=INFO
DATA_DIR=./data

# ---- Frontend ----
BACKEND_URL=http://localhost:8000
